# ============================================================================
# ONE PLACE FOR ALL YOUR KEYS.   Copy this file to  keys.env  and paste values.
#   cp keys.env.example keys.env      (keys.env is git-ignored: it is never uploaded)
# Then run:   scripts/keys/push-keys.sh        (sends each key to the right place)
# Leave a line blank to skip it. Blank never deletes an existing key.
# Paste the value right after the = sign and nothing else on that line (no spaces, no comments).
# ============================================================================

# ---- Setup (used by the script only, not stored anywhere) ----
# Supabase: the ID in your project URL  https://<THIS>.supabase.co
PROJECT_REF=
GITHUB_REPO=Bhajrang-Fitness-SRB/Bhajrang_Fitness_SRB

# ---- Goes to Supabase -> Edge Function Secrets (all functions read from here) ----
# aistudio.google.com -> Get API key
GEMINI_API_KEY=
# console.groq.com -> API Keys
GROQ_API_KEY=
# optional: console.anthropic.com -> API keys
ANTHROPIC_API_KEY=
# optional: Anthropic console -> your workspace id
ANTHROPIC_WORKSPACE_ID=
# Meta for Developers -> your app -> WhatsApp -> API Setup -> access token
WHATSAPP_TOKEN=
# same page: Phone number ID
WHATSAPP_PHONE_NUMBER_ID=
# social agent: same value as WHATSAPP_TOKEN
WA_ACCESS_TOKEN=
# social agent: same value as WHATSAPP_PHONE_NUMBER_ID
WA_PHONE_NUMBER_ID=
# Meta app -> Settings -> Basic -> App secret
META_APP_SECRET=
# any random text YOU invent; must match the webhook setting in Meta
META_VERIFY_TOKEN=
# Meta -> Messenger / Instagram setup -> generate Page access token
PAGE_ACCESS_TOKEN=
# your own number with country code, digits only e.g. 919876543210
OWNER_WHATSAPP=
# any long random text YOU invent; same one goes in setup/social-agent/cron.sql
SOCIAL_CRON_SECRET=
APP_URL=https://bhajrang-fitness-srb.onrender.com
# resend.com -> API Keys
RESEND_API_KEY=
# a sender address verified in Resend -> Domains
RESEND_FROM_EMAIL=
# OneSignal -> your app -> Settings -> Keys & IDs
ONESIGNAL_APP_ID=
# same page: REST API Key
ONESIGNAL_API_KEY=
# Telegram -> chat with @BotFather -> /newbot
TELEGRAM_BOT_TOKEN=
# message your bot, then open api.telegram.org/bot<TOKEN>/getUpdates and copy chat id
TELEGRAM_CHAT_ID=
# Optional social-agent extras (WhatsApp template names from Meta WhatsApp Manager)
WA_RENEWAL_TEMPLATE=
WA_TEMPLATE_LANG=
OWNER_ALERT_TEMPLATE=
OWNER_ALERT_TEMPLATE_LANG=
# leave blank unless Meta retires the default version
GRAPH_VERSION=
# Hub safety switches: leave BLANK (= off). Set to true only when you want them on.
HUB_ALLOW_SQL=
HUB_ALLOW_DEPLOY=

# ---- Goes to GitHub -> Settings -> Secrets and variables -> Actions (nightly backup) ----
# Supabase -> Connect -> SESSION POOLER uri (put your DB password in it)
SUPABASE_DB_URL=
# you invent: 20+ characters, also keep it in a password manager and on paper
BACKUP_PASSPHRASE=

# ---- Goes to Render -> your service -> Environment (public values, the script only reminds you) ----
# Supabase -> Project Settings -> API -> Project URL
VITE_SUPABASE_URL=
# same page: anon / public key
VITE_SUPABASE_ANON_KEY=
