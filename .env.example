# Supabase Configuration
VITE_SUPABASE_URL=https://qcabkhhbcdjyefbwzexj.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Part 1: Third-Party API Keys (Store securely in Supabase Secrets)
# Groq Cloud (Llama-3) — Elite AI Coach for workout & diet plans
VITE_GROQ_API_KEY=your_groq_api_key_here

# Google AI Studio (Gemini 1.5 Flash) — Master backup & marketing brain
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Spoonacular / Edamam (Diet API) — Accurate calorie & macro generation
VITE_DIET_API_KEY=your_diet_api_key_here

# Meta Cloud API (WhatsApp) — Automated receipts & alerts
VITE_WHATSAPP_TOKEN=your_whatsapp_token_here
VITE_WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_business_account_id_here

# Resend (Automated Email) — Modern email platform for invoices
VITE_RESEND_API_KEY=your_resend_api_key_here

# OneSignal (Web Push Notifications) — Silent notifications even when app is closed
ONESIGNAL_APP_ID=your_onesignal_app_id_here
ONESIGNAL_API_KEY=your_onesignal_api_key_here

# Part 2: Free / Local APIs (No API Key Required)
# 20-Meter Location Check (HTML5 Geolocation + Turf.js) — Browser GPS, no key needed
VITE_LOCATION_CHECK=enabled

# Face Scan Attendance (face-api.js) — Browser-based face recognition, no key needed
VITE_FACE_SCAN=enabled

# Exercise Visuals & GIFs (wger API) — Open API, no key needed
VITE_EXERCISE_VISUAL=enabled

# SMS by SIM (Android SMS Gateway) — Local phone SMS, no key needed
VITE_LOCAL_SMS_GATEWAY=enabled

# Web Speech API (Voice Assistant for Kiosk) — Browser built-in, no key needed
VITE_VOICE_ASSISTANT=enabled
