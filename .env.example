# .env.example - copy to master_vault.env and fill values locally (DO NOT COMMIT real secrets)
# Core
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_key_here
DATABASE_URL=postgres://user:pass@host:5432/dbname

# Portal paths (optional; default values are set in code)
ADMIN_PORTAL_URL=/villain
DESK_PORTAL_URL=/administration
STAFF_PORTAL_URL=/commander
STUDENT_PORTAL_URL=/warrior

# Messaging / Bots
WHATSAPP_ACCESS_TOKEN=<redacted>
WHATSAPP_PHONE_NUMBER_ID=<redacted>
TELEGRAM_BOT_TOKEN=<redacted>
TELEGRAM_ADMIN_CHAT_ID=<redacted>

# AI / Integrations
GEMINI_API_KEY=<redacted>
GROQ_API_KEY=<redacted>
HUGGINGFACE_API_KEY=<redacted>

# Payment / UPI
UPI_ID=your_upi_id@bank

# Backup / Storage
CLOUDINARY_URL=<redacted>

# Other
ADMIN_PIN=<redacted>
