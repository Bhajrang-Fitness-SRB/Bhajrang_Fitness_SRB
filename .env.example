# .env.example - copy to master_vault.env and fill values locally (DO NOT COMMIT real secrets)
# Core
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_key_here
DATABASE_URL=postgres://user:pass@host:5432/dbname

# Portal paths (optional; default values are set in code)
ADMIN_PORTAL_URL=/villain
DESK_PORTAL_URL=/administration
STAFF_PORTAL_URL=/commander
STUDENT_PORTAL_URL=/warrior

# Messaging / Bots — Official Meta WhatsApp Business Cloud API
WHATSAPP_ACCESS_TOKEN=<your Meta permanent access token>
WHATSAPP_PHONE_NUMBER_ID=<your WhatsApp Business phone number ID>
TELEGRAM_BOT_TOKEN=<redacted>
TELEGRAM_CHAT_ID=<redacted>

# Email (new — required for auto-emailing Member ID + Passcode on approval)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=<your sending mailbox>
SMTP_PASS=<app password, not your normal login password>
SMTP_FROM_NAME=Bhajrang Fitness SRB

# AI / Integrations
GEMINI_API_KEY=<redacted>
GROQ_API_KEY=<redacted>
HUGGINGFACE_API_KEY=<redacted>

# Payment / UPI
UPI_ID=your_upi_id@bank

# Backup / Storage
CLOUDINARY_URL=<redacted>

# Other
ADMIN_PIN=<redacted>
