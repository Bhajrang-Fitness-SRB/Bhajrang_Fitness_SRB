{
  "name": "rbf-ghost-vault",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "npx -y tsx --test tests/kiosk/voice.test.ts && npx -y tsx --test tests/agent-hub/hub.test.ts && node --test tests/social-agent/social.test.mjs && node --import ./tests/social-agent/smoke/register.mjs --test tests/social-agent/smoke/flow.test.mjs && node --test tests/install/manifest.test.mjs && npx -y tsx --test tests/gate/qr.test.ts && node tests/kiosk/sql.test.mjs",
    "test:db": "node scripts/dev/replay-migrations.mjs",
    "test:install": "bash scripts/make-installer.sh && node scripts/dev/test-install-sql.mjs",
    "installer": "bash scripts/make-installer.sh"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.468.0",
    "papaparse": "^5.4.1",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/papaparse": "^5.3.15",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "embedded-postgres": "^18.4.0-beta.17",
    "pg": "^8.23.1",
    "typescript": "^5.6.3",
    "vite": "^6.0.5"
  }
}
