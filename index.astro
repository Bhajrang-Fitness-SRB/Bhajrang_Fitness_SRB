---
import site from '../data/site.json';
const sorted = (s) => s.kind === 'updates'
  ? [...s.items].sort((a, b) => (b.date || '').localeCompare(a.date || ''))
  : s.items;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>SRB Bhajrang Fitness</title>
  <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;800&family=Barlow:wght@400;500&display=swap" rel="stylesheet" />
</head>
<body>
  <header class="hero"><div class="wrap">
    <h1>{site.hero.a}<span>{site.hero.b}</span></h1>
    <p>{site.hero.sub}</p>
    <a class="btn" href="#join">{site.hero.cta}</a>
  </div></header>

  {site.sections.map((s) => (
    <section><div class="wrap">
      <h2>{s.title}</h2>
      {s.kind === 'text'
        ? s.items.map((i) => <p class="body">{i.d}</p>)
        : <div class={`grid c${s.cols}`}>
            {sorted(s).map((i) => (
              <div class="card">
                {i.img && <img src={i.img} alt={i.t} loading="lazy" />}
                {s.kind === 'updates' && i.date && <small>{i.date}</small>}
                <h3>{i.t}</h3><p>{i.d}</p>
              </div>
            ))}
          </div>}
    </div></section>
  ))}

  <section id="join"><div class="wrap">
    <h2>Join the gym</h2>
    <form class="join" id="f" data-wa={site.wa}>
      <label>Name<input id="n" required autocomplete="name" /></label>
      <label>Mobile number<input id="m" type="tel" required autocomplete="tel" /></label>
      <label>Your goal
        <select id="g"><option>Build strength</option><option>Lose weight</option><option>Personal coaching</option><option>Not sure yet</option></select>
      </label>
      <button class="btn" type="submit">Send on WhatsApp</button>
    </form>
  </div></section>

  <footer><div class="wrap">{site.foot}</div></footer>

  <script is:inline>
    document.getElementById('f').addEventListener('submit', function (e) {
      e.preventDefault();
      var num = (this.dataset.wa || '').replace(/\D/g, '');
      var t = 'Hi, I’m ' + n.value + ' (' + m.value + '). My goal: ' + g.value + '.';
      window.open('https://wa.me/' + num + '?text=' + encodeURIComponent(t), '_blank');
    });
  </script>

  <style is:global>
    :root{--bg:#EEF1F4;--surface:#fff;--ink:#14233B;--muted:#4b5a70;--accent:#E8820C;--line:#cfd6df}
    @media (prefers-color-scheme:dark){:root{--bg:#101a2b;--surface:#18263c;--ink:#eef1f4;--muted:#aab6c7;--line:#2c3c55;color-scheme:dark}}
    *{box-sizing:border-box}
    body{margin:0;background:var(--bg);color:var(--ink);font:400 17px/1.6 Barlow,system-ui,sans-serif}
    h1,h2,h3{font-family:'Barlow Condensed',Impact,sans-serif;line-height:1;margin:0}
    .wrap{max-width:960px;margin:0 auto;padding:0 20px}
    .hero{padding:56px 0 48px}
    h1{font-weight:800;font-size:clamp(56px,16vw,128px)}
    h1 span{display:block;color:var(--accent)}
    .hero p{max-width:34em;color:var(--muted);font-size:19px;margin:20px 0 28px}
    .btn{display:inline-block;background:var(--accent);color:#14233B;font:800 20px 'Barlow Condensed',sans-serif;padding:12px 24px;border:0;border-radius:4px;text-decoration:none;cursor:pointer}
    section{padding:40px 0;border-top:1px solid var(--line)}
    h2{font-weight:800;font-size:clamp(34px,8vw,52px);margin-bottom:20px}
    .grid{display:grid;gap:16px;grid-template-columns:1fr}
    @media(min-width:640px){.c2,.c4{grid-template-columns:repeat(2,1fr)}.c3{grid-template-columns:repeat(3,1fr)}}
    @media(min-width:900px){.c4{grid-template-columns:repeat(4,1fr)}}
    .card{background:var(--surface);border-left:6px solid var(--accent);padding:18px 20px}
    .card img{display:block;width:calc(100% + 40px);margin:-18px -20px 14px;max-width:none;height:180px;object-fit:cover}
    .card h3{font-weight:800;font-size:28px;margin-bottom:6px}
    .card p{margin:0;color:var(--muted);white-space:pre-wrap}
    .card small{color:var(--accent);font-weight:500}
    .body{max-width:36em;white-space:pre-wrap}
    form.join{display:grid;gap:14px;max-width:460px}
    label{font-weight:500;display:grid;gap:4px}
    input,select{font:inherit;width:100%;padding:10px;border:1px solid var(--line);border-radius:4px;background:var(--surface);color:var(--ink)}
    footer{padding:28px 0 40px;color:var(--muted);border-top:1px solid var(--line)}
  </style>
</body>
</html>
